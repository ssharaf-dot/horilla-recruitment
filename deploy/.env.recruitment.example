# Copy to .env.recruitment, protect the file, and supply fresh secrets locally.
# Hexadecimal database passwords avoid URL-encoding issues in DATABASE_URL.
DB_NAME=horilla_recruitment
DB_USER=horilla_recruitment
DB_PASSWORD=
SECRET_KEY=
DB_INIT_PASSWORD=
HORILLA_RECRUITMENT_ONLY=false
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TIME_ZONE=UTC
